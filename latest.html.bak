<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>Daily MOO:conomy</title>
<style>
  /* 다크 에디토리얼 뉴스레터 — table/block만 사용, JS·외부 폰트·이미지·
     flex·grid 없음. 바깥 프레임은 밝게, 실제 뉴스레터 캔버스만 다크
     네이비로 렌더한다.

     일반 클라이언트: .wrap은 유동폭(width:100%)이며 데스크톱에서만
     max-width:760px으로 상한을 둔다. Outlook(Windows) 전용 고정폭은
     본문의 MSO 조건부 주석(<!--[if mso]>...<![endif]-->) wrapper
     안에서만 처리하며, 그 밖에서는 고정폭을 쓰지 않는다. */
  body { font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Malgun Gothic',Arial,sans-serif; background:#F2F3F5; color:#E8ECF3; margin:0; padding:0; -webkit-text-size-adjust:100%; text-size-adjust:100%; line-height:1.55; font-size:13px; }
  .outer-pad { padding:28px 16px; }
  .wrap { width:100%; max-width:760px; margin:0 auto; background:#0B1220; border-radius:12px; }
  .inner { padding:0 17px; }
  @media (max-width:780px) {
    .wrap { width:100% !important; max-width:100% !important; border-radius:0 !important; }
    .outer-pad { padding:14px 8px !important; }
  }

  /* ===== 01. DARK MASTHEAD ===== */
  .fx-mh { padding:18px 0 2px; }
  .fx-mh-table { width:100%; border-collapse:collapse; }
  .fx-brand { font-size:20px; font-weight:800; color:#E8ECF3; }
  .fx-brand .g { color:#F2C94C; }
  .fx-status { text-align:right; }
  .fx-status-chip { display:inline-block; font-size:10.5px; font-weight:700; color:#F2C94C; background:rgba(242,201,76,.15); padding:3px 9px; border-radius:20px; }
  .fx-mh-tagline { font-size:11.5px; font-weight:500; color:#95A2BA; line-height:1.5; margin-top:7px; word-break:keep-all; }
  .fx-mh-pubdate { font-size:9.5px; font-weight:500; color:#6B7A99; margin-top:8px; }
  .fx-mh-sub { font-size:10.5px; font-weight:600; color:#7C8AA5; letter-spacing:.03em; margin-top:3px; }

  /* 공용 section 라벨(모듈 섹션용, gold caps) */
  .fx-label { font-size:11.5px; font-weight:800; color:#F2C94C; letter-spacing:.08em; margin:26px 0 12px; text-transform:uppercase; word-break:keep-all; overflow-wrap:break-word; }
  .fx-label.first { margin-top:4px; }

  /* ===== 02. MORNING THESIS — 카드 없는 독립 편집 영역, 절제된 헤드라인(축소) ===== */
  .fx-mt { padding:2px 0 8px; }
  .fx-mt-label { font-size:10px; font-weight:800; color:#F2C94C; letter-spacing:.12em; text-transform:uppercase; margin-bottom:9px; }
  .fx-mt-headline { font-size:18px; font-weight:700; color:#F4F6FA; line-height:1.35; letter-spacing:-.2px; word-break:keep-all; overflow-wrap:break-word; max-height:3.6em; overflow:hidden; }
  .fx-mt-rule { height:1px; background:rgba(124,138,165,.22); margin-top:15px; }
  @media (min-width:701px) {
    .fx-mt-headline { font-size:21px !important; max-height:none !important; }
  }

  /* ===== 03. TODAY 3 SIGNALS — 카드 아님, 컴팩트 inline row ===== */
  .fx-t3-table { width:100%; border-collapse:collapse; margin-top:2px; }
  .fx-t3-table td { padding:4px 0 5px; border-bottom:1px solid rgba(124,138,165,.12); }
  .fx-t3-table tr.last td { border-bottom:none; }
  .fx-t3-mark { width:18px; font-size:13px; font-weight:800; color:#F2C94C; }
  .fx-t3-text { font-size:13px; font-weight:600; color:#E8ECF3; line-height:1.5; word-break:keep-all; overflow-wrap:break-word; }

  /* ===== 04. MAIN 6 METRICS — 단일 3열×2행 테이블(모바일/데스크톱 공용) ===== */
  .fx-mgrid { width:100%; border-collapse:separate; border-spacing:6px; margin:10px -6px 0; table-layout:fixed; }
  .fx-mbox { box-sizing:border-box; background:#141C2E; border-radius:8px; padding:9px 8px; vertical-align:top; }
  .fx-mlabel { font-size:9.5px; font-weight:700; color:#7C8AA5; letter-spacing:.02em; }
  .fx-mvalue { font-size:18px; font-weight:800; color:#E8ECF3; margin-top:5px; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .fx-mvalue-missing { color:#4a5570; }
  .fx-mchip { display:inline-block; font-size:10px; font-weight:700; padding:2px 7px; border-radius:20px; margin-top:6px; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .fx-mchip.up { background:rgba(255,107,107,.16); color:#FF6B6B; }
  .fx-mchip.down { background:rgba(91,141,239,.16); color:#5B8DEF; }
  .fx-mchip.flat { background:rgba(124,138,165,.16); color:#7C8AA5; }
  .fx-asof { font-size:10.5px; color:#7C8AA5; margin:10px 2px 0; }
  @media (max-width:400px) {
    .fx-mvalue { font-size:17px !important; }
    .fx-mvalue.fx-mvalue-fx { font-size:15.5px !important; }
    .fx-mchip { font-size:9.5px !important; padding:2px 5px !important; }
  }

  /* ===== 05. MARKET TEMPERATURE — 신규 독립 섹션 ===== */
  .fx-temp-card { background:#141C2E; border-radius:10px; padding:16px 15px; }
  .fx-temp-status { font-size:14px; font-weight:750; color:#F4F6FA; }
  .fx-temp-summary { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#C7CEDB; line-height:1.55; margin-top:7px; }
  .fx-temp-bar { width:100%; border-collapse:separate; border-spacing:3px 0; margin-top:14px; table-layout:fixed; }
  .fx-temp-seg { height:6px; background:#2A3450; border-radius:3px; font-size:0; line-height:0; }
  .fx-temp-seg.active { background:#F2C94C; }
  .fx-temp-labels { width:100%; border-collapse:separate; border-spacing:3px 0; margin-top:6px; table-layout:fixed; }
  .fx-temp-labels td { font-size:9.5px; color:#6B7A99; text-align:center; }
  .fx-temp-labels td.active { color:#F2C94C; font-weight:700; }
  .fx-temp-reasons { margin-top:13px; }
  .fx-temp-reason-item { word-break:keep-all;overflow-wrap:break-word;font-size:12px; color:#95A2BA; line-height:1.5; margin-top:4px; }
  .fx-temp-reason-item.up { color:#FF6B6B; }
  .fx-temp-reason-item.down { color:#5B8DEF; }
  .fx-temp-asof { font-size:10.5px; color:#7C8AA5; margin-top:12px; }

  /* 시장 온도 미니 추이(최근 최대 5거래일, table/막대만 사용) */
  .fx-temp-trend { width:100%; border-collapse:separate; border-spacing:4px 0; margin-top:14px; table-layout:fixed; }
  .fx-temp-trend-col { text-align:center; }
  .fx-temp-trend-bar-wrap { height:26px; }
  .fx-temp-trend-lbl { font-size:9px; color:#6B7A99; margin-top:4px; }
  .fx-temp-trend-lbl.today { color:#F2C94C; font-weight:700; }

  /* ===== 06. MAIN STORY ===== */
  .fx-story-h { font-size:19px; font-weight:750; color:#F4F6FA; line-height:1.32; margin-bottom:8px; word-break:keep-all; overflow-wrap:break-word; }
  .fx-story-meta { font-size:10.5px; color:#7C8AA5; font-weight:600; margin-bottom:13px; }
  .fx-story-why { margin-top:16px; background:#1B2740; border-left:3px solid #F2C94C; padding:11px 13px; border-radius:0 6px 6px 0; }
  .fx-story-why-lbl { display:block; font-size:10px; font-weight:800; color:#F2C94C; letter-spacing:.06em; text-transform:uppercase; }
  .fx-story-why-txt { word-break:keep-all;overflow-wrap:break-word;font-size:13.5px; color:#D9DFEA; line-height:1.55; margin-top:6px; }
  .fx-story-signal { display:inline-block; font-size:10.5px; font-weight:700; color:#F2C94C; background:rgba(242,201,76,.14); padding:3px 9px; border-radius:20px; margin-top:13px; }
  .fx-story-src { margin-top:8px; }
  .fx-story-empty { margin-top:16px; background:#1B2740; border-radius:10px; padding:14px 15px; word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#95A2BA; line-height:1.5; }
  .fx-story-src-link { display:block; min-height:26px; padding:4px 0; color:#8996AE; text-decoration:underline; font-size:10.5px; line-height:1.4; }

  /* ===== 07/08. DOMESTIC / GLOBAL NEWS — 컴팩트 에디토리얼 리스트(카드 아님) ===== */
  .fx-news-item { padding:12px 0; border-bottom:1px solid rgba(124,138,165,.14); }
  .fx-news-item.last { border-bottom:none; }
  .fx-news-title { font-size:13.5px; font-weight:700; color:#E8ECF3; line-height:1.45; word-break:keep-all; }
  .fx-news-fact { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#C7CEDB; line-height:1.5; margin-top:5px; }
  .fx-news-meta { font-size:10.5px; color:#7C8AA5; margin-top:7px; }
  .fx-news-meta a { color:#8996AE; text-decoration:underline; }
  .fx-news-empty { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#6B7A99; padding:6px 0; }

  /* ===== 09. MOO:VIEW — flagship, 유일한 장문 섹션(단일 자연스러운 컬럼) ===== */
  .fx-mv-wrap { margin-top:26px; }
  .fx-mv-card { background:#1B2740; border-radius:10px; padding:20px 17px; }
  .fx-mv-head { font-size:10px; font-weight:800; color:#F2C94C; letter-spacing:.1em; text-transform:uppercase; margin-bottom:13px; }
  .fx-mv-p { word-break:keep-all;overflow-wrap:break-word;font-size:13px; color:#D9DFEA; line-height:1.65; margin-top:11px; }
  .fx-mv-p.first { margin-top:0; }
  .fx-mv-meta { font-size:10.5px; color:#6B7A99; margin-top:16px; padding-top:11px; border-top:1px solid rgba(248,250,253,.1); }

  /* ===== 10. MOO:Q + MOO:CHECK — 연속 배치, MOO:CHECK는 한 단계 밝은 surface ===== */
  .fx-q-wrap { margin-top:22px; background:#1B2740; border:1px solid rgba(242,201,76,.3); border-radius:10px; padding:16px 15px; }
  .fx-q-lbl { font-size:10px; font-weight:800; color:#F2C94C; letter-spacing:.08em; text-transform:uppercase; margin-bottom:9px; }
  .fx-q-text { word-break:keep-all;overflow-wrap:break-word;font-size:14px; font-weight:650; color:#E8ECF3; line-height:1.55; }
  .fx-q-why { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#95A2BA; line-height:1.5; margin-top:7px; }
  .fx-q-meta { font-size:10.5px; color:#7C8AA5; margin-top:9px; }

  .fx-check-wrap { margin-top:8px; background:#202A3D; border:1px solid rgba(124,138,165,.3); border-radius:10px; padding:16px 15px; }
  .fx-check-lbl { font-size:10px; font-weight:800; color:#95A2BA; letter-spacing:.08em; text-transform:uppercase; margin-bottom:9px; }
  .fx-check-q { word-break:keep-all;overflow-wrap:break-word;font-size:13px; font-weight:650; color:#E8ECF3; line-height:1.5; }
  .fx-check-row { word-break:keep-all;overflow-wrap:break-word;font-size:12px; color:#C7CEDB; line-height:1.55; margin-top:8px; }
  .fx-check-row .k { color:#7C8AA5; font-weight:700; margin-right:5px; }
  .fx-check-verdict { display:inline-block; font-size:10.5px; font-weight:800; padding:3px 9px; border-radius:20px; margin-top:9px; }
  .fx-check-verdict.MATCH { background:rgba(255,107,107,.16); color:#FF6B6B; }
  .fx-check-verdict.MISS { background:rgba(91,141,239,.16); color:#5B8DEF; }
  .fx-check-verdict.PARTIAL, .fx-check-verdict.PENDING, .fx-check-verdict.INSUFFICIENT_DATA { background:rgba(124,138,165,.16); color:#95A2BA; }
  .fx-check-empty { word-break:keep-all;overflow-wrap:break-word;font-size:12px; color:#6B7A99; }

  /* ===== 11. KOREA MARKET & FLOW ===== */
  .fx-kf-card { background:#141C2E; border-radius:10px; padding:14px; margin-top:4px; }
  .fx-kf-market-lbl { font-size:11px; font-weight:700; color:#E8ECF3; margin-bottom:7px; }
  .fx-kf-market-lbl:not(:first-child) { margin-top:13px; }
  .fx-kf-table { width:100%; border-collapse:collapse; }
  .fx-kf-table td { padding:4px 2px; font-size:12px; border-bottom:1px solid rgba(124,138,165,.1); font-variant-numeric:tabular-nums; }
  .fx-kf-table tr.last td { border-bottom:none; }
  .fx-kf-who { color:#95A2BA; }
  .fx-kf-val { text-align:right; font-weight:700; }
  .fx-kf-val.up { color:#FF6B6B; }
  .fx-kf-val.down { color:#5B8DEF; }
  .fx-kf-val.flat { color:#95A2BA; }
  .fx-sector-row { margin-top:11px; font-size:11.5px; color:#95A2BA; }
  .fx-interp { word-break:keep-all;overflow-wrap:break-word;font-size:12px; color:#C7CEDB; line-height:1.55; margin-top:12px; padding-top:11px; border-top:1px solid rgba(124,138,165,.14); }

  /* ===== 12. OVERNIGHT GLOBAL & MACRO ===== */
  .fx-og-card { background:#141C2E; border-radius:10px; padding:14px; margin-top:4px; }
  .fx-og-group-lbl { font-size:9.5px; font-weight:700; color:#7C8AA5; letter-spacing:.05em; text-transform:uppercase; margin-bottom:6px; }
  .fx-og-group-lbl:not(:first-child) { margin-top:13px; }
  .fx-og-table { width:100%; border-collapse:collapse; }
  .fx-og-table td { padding:4px 2px; font-size:12px; border-bottom:1px solid rgba(124,138,165,.1); font-variant-numeric:tabular-nums; }
  .fx-og-table tr.last td { border-bottom:none; }
  .fx-og-label { color:#E8ECF3; font-weight:600; }
  .fx-og-val { text-align:right; color:#C7CEDB; }
  .fx-og-chg { text-align:right; font-weight:700; width:70px; }
  .fx-og-chg.up { color:#FF6B6B; }
  .fx-og-chg.down { color:#5B8DEF; }
  .fx-og-chg.flat { color:#95A2BA; }

  /* ===== 13. SIGNAL CHAIN — 모바일/태블릿 2행x2열, 데스크톱 1행x4열 ===== */
  .fx-sc-grid { width:100%; border-collapse:separate; border-spacing:6px; margin:0 -6px; table-layout:fixed; }
  .fx-sc-chip { box-sizing:border-box; background:#141C2E; border-radius:8px; padding:11px 10px; vertical-align:top; }
  .fx-sc-chip.outcome { border:1px solid rgba(242,201,76,.55); background:#171F30; }
  .fx-sc-role { font-size:9.5px; font-weight:700; color:#7C8AA5; text-transform:uppercase; letter-spacing:.03em; }
  .fx-sc-chip.outcome .fx-sc-role { color:#F2C94C; }
  .fx-sc-label { font-size:12px; font-weight:700; color:#E8ECF3; margin-top:5px; word-break:keep-all; }
  .fx-sc-detail { font-size:11px; color:#95A2BA; margin-top:4px; word-break:keep-all; line-height:1.45; }
  .fx-sc-detail.up { color:#FF6B6B; }
  .fx-sc-detail.down { color:#5B8DEF; }
  .fx-sc-note { word-break:keep-all;overflow-wrap:break-word;font-size:11.5px; color:#7C8AA5; line-height:1.55; margin-top:12px; }
  .fx-sc-strength { font-size:11px; color:#6B7A99; line-height:1.5; margin-top:8px; }
  /* 2026-08-25(TASK_ID=SIGNAL_CHAIN_EMPTY_STATE_HOTFIX) — .fx-word-empty(§14.5)와
     동일한 "실패를 숨기지 않는다" 원칙을 SIGNAL CHAIN에도 적용한다. */
  .fx-sc-empty { background:#141C2E; border-radius:8px; padding:14px 15px; word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#95A2BA; line-height:1.5; }
  .fx-sc-mobile { display:block; }
  .fx-sc-desktop { display:none; }
  @media (min-width:701px) {
    .fx-sc-mobile { display:none !important; }
    .fx-sc-desktop { display:block !important; }
  }

  /* ===== 14. TODAY'S WATCH ===== */
  .fx-watch-card { background:#141C2E; border-radius:10px; padding:14px 15px; }
  .fx-watch-row { width:100%; border-collapse:collapse; margin-top:8px; }
  .fx-watch-row.first { margin-top:0; }
  .fx-watch-num { font-size:11px; font-weight:700; color:#F2C94C; padding:1px 6px 0 0; }
  .fx-watch-txt { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#D9DFEA; line-height:1.55; }
  .fx-watch-oneliner { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; font-weight:600; color:#E8ECF3; line-height:1.55; margin-top:11px; padding-top:11px; border-top:1px solid rgba(124,138,165,.16); }

  /* ===== 14.5 MOO:워드 — footer 직전 마지막 콘텐츠 섹션(§10) ===== */
  .fx-word-card { background:#1B2740; border-radius:10px; padding:14px 15px; }
  .fx-word-term { font-size:15px; font-weight:800; color:#F2C94C; }
  .fx-word-def { word-break:keep-all;overflow-wrap:break-word;font-size:14px; color:#D9DFEA; line-height:1.55; margin-top:6px; }
  .fx-word-why { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#95A2BA; line-height:1.5; margin-top:8px; }
  .fx-word-hook { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#C7CEDB; line-height:1.5; margin-top:6px; }
  .fx-word-src { font-size:11px; color:#6B7A99; margin-top:9px; }
  .fx-word-empty { background:#1B2740; border-radius:10px; padding:14px 15px; word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#95A2BA; line-height:1.5; }
  /* 2026-08-14(TASK_ID=MOO_WORD_OFFICIAL_EVIDENCE_HOTFIX) — 공식 근거 표기.
     기존 .fx-word-src(11px/#6B7A99)보다 살짝 크고 밝게(Gmail·다크테마에서도
     "지나치게 작거나 흐리지 않게" 읽히도록) 하되, 정의 본문(.fx-word-def
     14px)보다는 작은 위계를 유지한다. */
  .fx-word-evidence { margin-top:10px; padding-top:9px; border-top:1px solid rgba(124,138,165,.16); }
  .fx-word-evidence-src { word-break:keep-all;overflow-wrap:break-word;font-size:12px; color:#B9C4DA; line-height:1.5; }
  .fx-word-evidence-ref { font-size:11.5px; color:#9AA8C4; margin-top:3px; }
  .fx-word-evidence-url { font-size:11.5px; margin-top:3px; }
  .fx-word-evidence-url a { color:#8FB8FF; text-decoration:underline; }

  /* ===== 15. RISK / SOURCE / CTA / FOOTER ===== */
  .fx-risk { margin-top:22px; border-left:3px solid #C9A227; background:rgba(201,162,39,.08); padding:10px 12px; border-radius:0 6px 6px 0; }
  .fx-risk-lbl { font-size:10px; font-weight:800; color:#D8B84A; letter-spacing:.06em; text-transform:uppercase; }
  .fx-risk-text { word-break:keep-all;overflow-wrap:break-word;font-size:12.5px; color:#D9DFEA; line-height:1.5; margin-top:5px; }
  .fx-src { margin-top:20px; }
  .fx-src-row { padding:3px 0; font-size:10.5px; line-height:1.45; color:#8996AE; }
  .fx-src-row .f-cat { font-weight:700; color:#9FACC4; }
  .fx-terminal-note { font-size:11px; color:#7C8AA5; margin-top:16px; }
  .fx-share { margin-top:16px; border-left:3px solid #C9A227; background:rgba(201,162,39,.08); padding:12px 14px; border-radius:0 6px 6px 0; }
  .fx-share-lbl { font-size:10px; font-weight:800; color:#D8B84A; letter-spacing:.06em; text-transform:uppercase; }
  .fx-share-text { word-break:keep-all;overflow-wrap:break-word; font-size:12px; color:#C7CEDD; line-height:1.55; margin-top:6px; }
  .fx-home-pill-wrap { width:100%; border-collapse:collapse; margin-top:14px; }
  .fx-home-pill-cell { border:1px solid #F2C94C; border-radius:20px; background:#141C2E; }
  /* 2026-08-08(PR#10 재검수): fx-home-pill-link/fx-unsubscribe-link의 44px
     min-height와 fx-copyright의 11.5px는 2026-08-07 golden baseline(c904a36)
     에 존재하지 않았다 — git pickaxe로 확인한 결과 이 값들이 main 계보에
     처음 들어온 지점은 f9f953e(2026-08-07 11:38 KST)이며, 그 이전에는
     36px/22px/11px였다(별도 접근성 승인 기록 없음). "접근성 목적이므로
     예외로 유지한다"는 판단은 사용자가 명시적으로 금지했으므로, 목적과
     무관하게 승인되지 않은 시각 변경으로 취급해 2026-08-07 값으로 되돌린다. */
  .fx-home-pill-link { display:inline-block; min-height:36px; line-height:36px; padding:0 18px; color:#F2C94C; text-decoration:none; font-size:11.5px; font-weight:700; }
  .fx-copyright { font-size:11px; color:#7C8AA5; margin-top:16px; }
  .fx-unsubscribe-link { display:inline-block; min-height:22px; padding:3px 0; color:#6B7A99; text-decoration:underline; font-size:10px; }
  .fx-signoff { font-size:10.5px; color:#7C8AA5; line-height:1.5; margin-top:4px; }
  /* item 5: 최상단 "웹에서 보기" 링크 — 밝은 바깥 배경(#F2F3F5) 위에 놓이므로
     다크카드용 색(#8996AE, 대비 2.69:1)이 아니라 대비 9.33:1인 어두운 색을
     사용한다(밝은 배경 전용 팔레트, 다른 다크카드 footer 링크와는 배경이
     다르다는 점에 유의). */
  .fx-view-in-browser { text-align:center; padding:8px 0 4px; }
  .fx-view-in-browser a { display:inline-block; min-height:32px; line-height:32px; color:#334155; text-decoration:underline; font-size:11.5px; }
</style>
</head>
