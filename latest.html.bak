     사용한다(밝은 배경 전용 팔레트, 다른 다크카드 footer 링크와는 배경이
     다르다는 점에 유의). */
  .fx-view-in-browser { text-align:center; padding:8px 0 4px; }
  .fx-view-in-browser a { display:inline-block; min-height:32px; line-height:32px; color:#334155; text-decoration:underline; font-size:11.5px; }
